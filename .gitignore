# 误创建的临时文件/垃圾
desktop/release-dist/
_t*.txt
_*.txt
tmp-redteam/
[{]*
_*

# 运行时迁移标记（dev 数据目录用，不入库）
desktop/.project-migrated

# 构建产物与运行记录（不入库：含打包副本/本机运行输出）
desktop/release-*/
desktop/workflow-runs/

# 本地审计产物与临时文件（勿提交）
.finalcheck/*
!/.finalcheck/accept.json
e2e-artifacts/
.fc-probe-walk*/
.fc-selfaudit/
.scratch-robust/
.tmp-*/
.tmp-*
desktop/.pt-built.mjs
*.log
nul-*.json

# 完整 Git for Windows 运行时（392MB / 9296 文件，不能进版本库）
# 由 scripts/fetch-gitbash.mjs 在打包前从本机或官方安装包准备
desktop/resources/gitbash-full/

# Python 包标记文件不能被上面的 _* 规则吞掉（基准项目与任何 Python 包都需要）
!__init__.py
# 桌面开发版运行时生成的工作区列表与编辑快照（不入库）
desktop/projects.json
desktop/snapshots/
