{
  "name": "finalcheck-desktop",
  "productName": "FinalCheck",
  "version": "0.28.0",
  "author": "Sean (https://github.com/ccai40359-wq)",
  "description": "FinalCheck 终检台桌面端：全方位代码体检 + 渗透/压测 + AI Agent",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/prepare-rg.mjs win32 && electron-vite build && electron-builder --win nsis --publish never",
    "dist:dir": "node scripts/prepare-rg.mjs win32 && electron-vite build && electron-builder --win dir",
    "dist:linux": "node scripts/prepare-rg.mjs linux && electron-vite build && electron-builder --linux AppImage deb --publish never",
    "dist:linux:dir": "node scripts/prepare-rg.mjs linux && electron-vite build && electron-builder --linux dir",
    "prepare:rg": "node scripts/prepare-rg.mjs",
    "fetch:rg:linux": "node scripts/fetch-rg-linux.mjs",
    "playwright:install": "playwright install chromium",
    "playwright:install:linux": "playwright install --with-deps chromium",
    "preview": "electron-vite preview",
    "setup:sqlite": "node scripts/ensure-sqlite-binding.mjs",
    "postinstall": "node scripts/ensure-sqlite-binding.mjs",
    "check:package": "node scripts/check-package-hygiene.mjs"
  },
  "build": {
    "appId": "com.finalcheck.terminal",
    "productName": "FinalCheck",
    "copyright": "Copyright © 2026 Sean",
    "artifactName": "fc-setup-${version}.${ext}",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ccai40359-wq",
        "repo": "finalcheck"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/rg",
        "to": "rg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/gitbash-full",
        "to": "gitbash-full",
        "filter": [
          "**/*",
          "!**/tmp/**",
          "!**/.mimosa/**",
          "!unins*"
        ]
      },
      {
        "from": "build/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "../CHANGELOG.en.md",
        "to": "CHANGELOG.en.md"
      },
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*",
          "!**/.mimosa/**",
          "!**/.mimosa"
        ]
      },
      {
        "from": "../playbooks",
        "to": "playbooks",
        "filter": [
          "**/*",
          "!**/.mimosa/**",
          "!**/.mimosa"
        ]
      },
      {
        "from": "src",
        "to": "desktop/src",
        "filter": [
          "**/*",
          "!**/.mimosa/**",
          "!**/.mimosa"
        ]
      },
      {
        "from": "build",
        "to": "app/build",
        "filter": [
          "**/*",
          "!**/.mimosa/**",
          "!**/.mimosa"
        ]
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "**/*",
          "!**/.mimosa/**",
          "!**/.mimosa"
        ]
      }
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "finalcheck",
      "synopsis": "AI 写的代码，交付前先验一遍",
      "description": "FinalCheck 终检台：全方位代码体检 + 渗透/压测 + AI Agent",
      "target": [
        "AppImage",
        "deb"
      ],
      "desktop": {
        "entry": {
          "Name": "FinalCheck",
          "Comment": "AI code acceptance terminal",
          "Categories": "Development;Security;"
        }
      }
    },
    "appImage": {
      "artifactName": "fc-${version}.${ext}"
    },
    "deb": {
      "artifactName": "fc-${version}.${ext}",
      "depends": [
        "bash",
        "git",
        "ripgrep",
        "bubblewrap",
        "socat"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "legalTrademarks": "FinalCheck",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FinalCheck",
      "uninstallDisplayName": "FinalCheck",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dompurify": "^3.2.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^2.3.0",
    "marked": "^15.0.6",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.83",
    "autocannon": "^7.15.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.11",
    "playwright": "1.65.1"
  }
}
