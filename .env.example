# FinalCheck environment variables — names and placeholders only.
# Copy to .env only if you need to override a default. Never put real credentials here.
# System variables (APPDATA, USERPROFILE, CI, PYTHON) are set by the OS or test runner.

APPDATA=
USERPROFILE=
CI=
PYTHON=python
SMOKE_TARGET=http://127.0.0.1:3000
USERNAME=test-user

ELECTRON_RENDERER_URL=http://localhost:5173

FINALCHECK_CONFIG_FILE=<path-to-config.json>
FINALCHECK_PROJECTS_FILE=<path-to-projects.json>
FINALCHECK_SESSIONS_DIR=<path-to-sessions-dir>
FINALCHECK_MEMORY_DIR=<path-to-memory-dir>
FINALCHECK_SPILL_DIR=<path-to-spill-dir>
FINALCHECK_USAGE_FILE=<path-to-usage.json>
FINALCHECK_HOOKS_FILE=<path-to-hooks.json>
FINALCHECK_SESSION_STORE=<store-backend>
FINALCHECK_DEFAULT_PROJECT=<path-to-default-project>
FINALCHECK_MAX_TURNS=12
FINALCHECK_STREAM_USAGE=1
FINALCHECK_SQLITE_BINARY_HOST=https://npmmirror.com/mirrors/better-sqlite3

# Internal/test helper name referenced by the audit code:
X=<placeholder>
